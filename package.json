{
  "name": "llm-admin-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "LLM Admin UI desktop and web admin shell (consumes llm-admin-gateway submodule)",
  "scripts": {
    "dev": "vite --port 5173 --strictPort --open",
    "dev:gateway": "npm --prefix src-gateway run dev -- --config=../conf.json",
    "dev:desktop": "cd desktop && node scripts/copy-binary.js && neu run",
    "build": "npm run build:web && npm run build:gateway",
    "build:web": "node scripts/check-submodule.js && vite build --mode web",
    "build:gateway": "npm --prefix src-gateway run build",
    "build:desktop": "npm --prefix src-gateway run build:bun && rm -rf desktop/resources/assets desktop/resources/index.html && vite build --mode desktop && cd desktop && neu build && node scripts/copy-binary.js",
    "start": "node src-gateway/build/start-server.js",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "setup:desktop": "cd desktop && neu update"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/node": "^20.19.0",
    "@vitejs/plugin-react": "latest",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.0.6",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.8.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
