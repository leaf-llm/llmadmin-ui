# ---------------------------------------------------------------------------
# LLM Admin web deployment
# Copy to .env and fill in values for local Docker/PaaS deployments.
# Never commit .env.
# ---------------------------------------------------------------------------

# HTTP port. Render/Railway/Fly inject PORT automatically; this is a fallback.
PORT=8700

# ---------------------------------------------------------------------------
# Storage (default: ephemeral file, no database)
# ---------------------------------------------------------------------------
# file is the default so a free Render service needs no database or disk.
# The container's /tmp is writable, but it is NOT persistent: config and usage
# are lost when the service restarts, redeploys, or wakes from a free-plan sleep.
CONFIG_STORE=file
CONFIG_PATH=/tmp/llmadmin/conf.json
HOME=/tmp/llmadmin

# file | memory | postgres | auto
USAGE_STORE=file
USAGE_FLUSH_MS=10000

# How long an instance may serve a cached config before re-reading it.
CONFIG_CACHE_TTL_MS=1000

# PostgreSQL is optional. To persist config/usage, uncomment and fill these:
# CONFIG_STORE=postgres
# USAGE_STORE=postgres
# DATABASE_URL=postgres://user:password@host:5432/llmadmin
# DATABASE_SSL=auto
# DATABASE_POOL_MAX=3

# Admin UI login token. Generate a long random value:
#   openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-token

# Gateway data-plane key. Clients must send:
#   Authorization: Bearer <GATEWAY_API_KEY>
# or x-api-key: <GATEWAY_API_KEY>
GATEWAY_API_KEY=change-me-to-another-long-random-token

# Set to true only for a deliberately public/open gateway.
GATEWAY_AUTH_DISABLED=false

# Set to true only for local development without an admin token.
ADMIN_AUTH_DISABLED=false

# Comma-separated additional origins allowed to call the admin API.
# Same-origin is always allowed. Do not use "*".
ADMIN_CORS_ORIGINS=

# Serve the React admin at /public/admin/ and redirect / to it.
WEB_UI=true

# Keep the legacy /public/ log viewer disabled in web deployments.
ENABLE_LEGACY_LOGS=false

# Allow provider base URLs that point at localhost/private networks
# (only enable for a self-hosted Ollama or similar).
ALLOW_PRIVATE_PROVIDER_HOSTS=false

# Request body limits (bytes).
ADMIN_MAX_BODY_BYTES=2097152
MAX_BODY_BYTES=26214400

# Optional first-boot seed for a stateless/read-only deployment.
# Set CONFIG_STORE=env and provide the full unified config as JSON.
# LLMADMIN_CONFIG_JSON=
