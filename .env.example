# Minimal configuration for the default file-mode deployment.
# Copy to .env for docker compose. Never commit .env.
#
# The Docker image already sets NODE_ENV=production, PORT=8700, WEB_UI=true
# and ENABLE_LEGACY_LOGS=false, so they are intentionally not repeated here.

# Required: admin UI login token and gateway data-plane key.
# Generate values with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-token
GATEWAY_API_KEY=change-me-to-another-long-random-token

# Ephemeral file storage inside the container.
# Restart/redeploy loses this data; export the config from Settings if needed.
CONFIG_STORE=file
CONFIG_PATH=/tmp/llmadmin/conf.json
USAGE_STORE=file
HOME=/tmp/llmadmin

# Optional: persist config/usage in PostgreSQL or Neon instead.
# Uncomment all of these and set DATABASE_URL.
# CONFIG_STORE=postgres
# USAGE_STORE=postgres
# DATABASE_URL=postgres://user:password@host:5432/llmadmin
# DATABASE_SSL=auto
